{
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/sites", "destination": "/api" },
    { "source": "/sites/(.*)", "destination": "/api" },
    { "source": "/hours", "destination": "/api" },
    { "source": "/workloads", "destination": "/api" },
    { "source": "/planner", "destination": "/api" },
    { "source": "/planner/(.*)", "destination": "/api" },
    { "source": "/demo/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
