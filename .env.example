# Copy to .env and fill in. Never commit the real key.
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
FORTYGUARD_ENV_PARAMS=wet_bulb_temperature_celsius,apparent_temperature_celsius,relative_humidity_percent
DATABASE_PATH=backend/data/heat_planner.db
# Optional — AI brief can narrate calculated results. Without it, deterministic Q&A still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
